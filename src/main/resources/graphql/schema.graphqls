type Post {
    id: ID!
    content: String!
    comments: [Comment]
}

type Comment {
    id: ID!
    content: String!
    postId: String!
}

type Query {
    postById(id: ID!): Post
}

type Mutation {
    createPost(content: String!): [Post]
    createComment(postId: String!, content: String!): [Comment]
}